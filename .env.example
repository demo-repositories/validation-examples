# Copy to .env and fill in your project. .env is gitignored.
# Studio and App SDK (safe to expose to signed-in Sanity users)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=validation
SANITY_APP_PROJECT_ID=
SANITY_APP_DATASET=validation
SANITY_APP_ORGANIZATION_ID=

# Server only: use a token with read access to the dataset.
SANITY_PROJECT_ID=
SANITY_DATASET=validation
SANITY_API_READ_TOKEN=
PORT=3001
